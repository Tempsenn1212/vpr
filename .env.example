# Node.js 24. Для локальной разработки npm run dev явно включает DEV_AUTH.
NODE_ENV=development
DEV_AUTH=true
PORT=3000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Europe/Moscow
DATABASE_PATH=data/vpr.sqlite
# Production: NODE_ENV=production, DEV_AUTH=false, новый путь к чистой БД.
# Секрет задаётся только на сервере. Не включайте реальные значения в Git.
BOT_TOKEN=
INITIAL_ADMIN_TELEGRAM_ID=
