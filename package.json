{
  "name": "vpr-document-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "cloudflare:dev": "npm run build && wrangler dev --test-scheduled",
    "cloudflare:setup": "node --env-file-if-exists=.env scripts/cloudflare-setup.mjs",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:export": "node --env-file-if-exists=.env scripts/cloudflare-export.mjs",
    "test:cloudflare": "npm run build && node --test tests/cloudflare/*.test.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
