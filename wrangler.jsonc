{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpr-document-tracker",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "VPR_DB", "class_name": "VprDatabase" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VprDatabase"] }],
  "triggers": { "crons": ["* * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "APP_TIMEZONE": "Europe/Moscow", "AUTOMATIC_DOCUMENTS": "true" },
  "observability": { "enabled": false },
}
